# Default local mode: runs against the included course CSV data.
DATA_SOURCE=csv
CSV_PATH=data/aac_shelter_outcomes.csv

# MongoDB mode for an environment where a real MongoDB instance is available.
# DATA_SOURCE=mongo
# MONGO_URI=mongodb://username:password@localhost:27017/?authSource=admin
MONGO_DATABASE=AAC
MONGO_COLLECTION=animals

HOST=127.0.0.1
PORT=8050
DEBUG=false
